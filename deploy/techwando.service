# /etc/systemd/system/techwando.service
# Bare-metal Ubuntu/Debian systemd service for TECHWANDO (Gunicorn)

[Unit]
Description=TECHWANDO Django Platform (Gunicorn)
After=network.target

[Service]
Type=notify
User=techwando
Group=www-data
WorkingDirectory=/srv/techwando
EnvironmentFile=/srv/techwando/.env
Environment="DJANGO_SETTINGS_MODULE=config.settings.production"
ExecStart=/srv/techwando/.venv/bin/gunicorn config.wsgi:application \
    --config /srv/techwando/deploy/gunicorn.conf.py \
    --bind unix:/run/techwando/gunicorn.sock
ExecReload=/bin/kill -s HUP $MAINPID
RuntimeDirectory=techwando
Restart=on-failure
RestartSec=5s

# Systemd security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/techwando/data /srv/techwando/media /srv/techwando/private_media /srv/techwando/logs /srv/techwando/backups /run/techwando
UMask=0027

[Install]
WantedBy=multi-user.target
