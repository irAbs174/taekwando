# =============================================================================
# TEAKWONDO — Environment Configuration Template
# Copy to `.env` and set secure values before running in production.
# NEVER commit `.env` to version control.
# =============================================================================

# Settings module:
#   config.settings.development
#   config.settings.production
#   config.settings.testing
DJANGO_SETTINGS_MODULE=config.settings.development

# Cryptographic secret key (REQUIRED in production; generate with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret-key-before-production

# Debug mode (MUST be False in production)
DJANGO_DEBUG=False

# Comma-separated allowed hosts & CSRF trusted origins
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://teakwondo.example.com

# Canonical site base URL (used for SEO canonical links, sitemaps, and emails)
SITE_BASE_URL=https://teakwondo.example.com
SITE_NAME=باشگاه تکواندو نیایش
CLUB_ADDRESS_FA=تهران | خیابان ولیعصر، بالاتر از چهارراه ولیعصر، کانون فرهنگی تربیتی نیایش
CLUB_MAP_URL=https://maps.app.goo.gl/GACjRuq4QeXWjHSQ6

# Custom obscured Django admin path (include trailing slash)
DJANGO_ADMIN_URL=django-admin/

# Default language: fa (Persian, RTL) or ko (Korean, LTR)
DJANGO_DEFAULT_LANGUAGE=fa
DJANGO_TIME_ZONE=UTC

# Database configuration (defaults to SQLite; supports seamless PostgreSQL migration)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
# Uncomment for PostgreSQL migration:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=teakwondo
# DB_USER=teakwondo_user
# DB_PASSWORD=replace-with-strong-password
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_CONN_MAX_AGE=60

# File storage & private media protection
MAX_UPLOAD_SIZE_MB=5
# Set True behind Nginx configured with an `internal` /_private_media/ location
USE_X_ACCEL_REDIRECT=False
X_ACCEL_REDIRECT_PREFIX=/_private_media

# Security & HTTPS (automatically enforced in config.settings.production)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
TRUST_X_FORWARDED_FOR=False

# Rate limiting
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW=300
CONTACT_RATE_LIMIT_ATTEMPTS=5
CONTACT_RATE_LIMIT_WINDOW=600

# Email configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@teakwondo.example.com
CLUB_CONTACT_EMAIL=info@teakwondo.example.com

# Optional error monitoring (Sentry)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Logging
DJANGO_LOG_LEVEL=INFO
